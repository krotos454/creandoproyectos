# ==========================================================================
# Copiá este archivo como ".env" (en la carpeta del proyecto) y completá los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).
# TODOS los valores de abajo son EJEMPLOS FICTICIOS: reemplazalos por los tuyos.
# ==========================================================================

# ---------- PÚBLICAS (van al navegador; no son secretas) ----------
# Supabase → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://ejemplo-ficticio.supabase.co
# Supabase → Project Settings → API Keys → clave "Publishable" (empieza con sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_EJEMPLO_FICTICIO
# Dirección del Worker de imágenes (la ves en Cloudflare → Workers & Pages al desplegarlo)
VITE_UPLOAD_API_URL=https://creandoproyectos-uploads.ejemplo-ficticio.workers.dev

# ---------- PRIVADAS: NO van en este archivo ----------
# - La clave secreta / service_role de Supabase: NO se usa en este proyecto. Nunca la pongas acá.
# - R2: el Worker accede al bucket por "binding" (se declara en worker/wrangler.toml);
#   no existen access keys de R2 en ningún lado del proyecto.
# - Si algún día necesitás un secreto en el Worker, se carga con:  npx wrangler secret put NOMBRE
#   (nunca en un archivo del proyecto ni con prefijo VITE_).
