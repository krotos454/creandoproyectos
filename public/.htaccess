# creandoproyectos · para hosting Apache (Namecheap/cPanel)
# Hace que /cursos/..., /contacto, etc. funcionen al refrescar la página o abrir un enlace directo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Obliga a usar https (descomentá estas líneas cuando el certificado SSL ya esté activo)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Los archivos de /assets llevan un código en el nombre: se pueden guardar un año en el navegador.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
